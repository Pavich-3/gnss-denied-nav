<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gnssd_tools</name>
  <version>0.0.1</version>
  <description>Project nodes (sensor_monitor_node, map_manager_node, odometry noise) and evaluation scripts</description>
  <maintainer email="pavlobaranchuk03072004@gmail.com">Pavlo Baranchuk</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- scripts/compare_odom.py -->
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
